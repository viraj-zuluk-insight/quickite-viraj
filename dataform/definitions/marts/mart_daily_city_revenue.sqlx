config {
  type: "table",
  schema: dataform.projectConfig.vars.marts_dataset,
  name: "mart_daily_city_revenue"
}

SELECT
  DATE(o.order_timestamp) AS order_date,
  r.city,
  COUNT(DISTINCT o.order_id) AS total_orders,
  SUM(i.line_total) AS total_revenue,
  AVG(i.line_total) AS avg_order_item_value
FROM
  ${ref("fct_orders")} o
JOIN
  ${ref("fct_order_items")} i ON o.order_id = i.order_id
JOIN
  ${ref("dim_restaurants")} r ON o.restaurant_id = r.restaurant_id
WHERE
  o.order_status = 'COMPLETED'
GROUP BY
  1, 2