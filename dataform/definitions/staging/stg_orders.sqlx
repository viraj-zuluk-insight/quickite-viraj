config {
  type: "view",
  schema: dataform.projectConfig.vars.staging_dataset,
  name: "stg_orders",
  assertions: {
    uniqueKey: ["order_id"],
    nonNull: ["order_id", "customer_id", "restaurant_id"]
  }
}

SELECT
  CAST(order_id AS INT64) AS order_id,
  CAST(customer_id AS INT64) AS customer_id,
  CAST(restaurant_id AS INT64) AS restaurant_id,
  PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', order_ts) AS order_timestamp,
  UPPER(TRIM(status)) AS order_status,
  LOWER(TRIM(payment_method)) AS payment_method,
  PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', updated_at) AS updated_at,
  _source_date,
  _ingested_at
FROM
  ${ref("orders")}
WHERE
  order_id IS NOT NULL